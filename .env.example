# ── Server ────────────────────────────────────
# Port the HTTP server listens on.
# Render sets this automatically; defaults to 3000 locally.
PORT=3000

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# Defaults to the production origins + localhost:3000 if not set.
# ALLOWED_ORIGINS=https://teenpati.utsavtripathi.com.np,https://utsavtripathi.com.np,http://localhost:3000
